# Athena Configuration Example
# Copy this file to .env and modify as needed

# =============================================================================
# SERVER CONFIGURATION
# =============================================================================

# Port the server will listen on (default: 9206)
PORT=9206

# Host the server will bind to (default: 0.0.0.0)
HOST=0.0.0.0

# Server timeouts (Go duration format: 15s, 5m, 1h)
READ_TIMEOUT=15s
WRITE_TIMEOUT=15s
IDLE_TIMEOUT=60s

# =============================================================================
# DATABASE CONFIGURATION
# =============================================================================

# Database type: sqlite only
DB_TYPE=sqlite

# SQLite database path
DB_PATH=./athena.db

# Database connection pool settings
DB_MAX_OPEN_CONNS=25
DB_MAX_IDLE_CONNS=5
DB_CONN_MAX_LIFETIME=5m

# =============================================================================
# SECURITY CONFIGURATION
# =============================================================================

# JWT secret for token signing (REQUIRED for production)
# Generate with: openssl rand -base64 32
JWT_SECRET=your-secret-key-here-change-in-production

# JWT token expiration (Go duration format)
JWT_EXPIRATION=24h

# BCrypt cost for password hashing (4-31, default: 10)
# Higher values = more secure but slower
BCRYPT_COST=10

# Session duration for cookie-based sessions
SESSION_DURATION=24h

# =============================================================================
# CORS CONFIGURATION
# =============================================================================

# Enable/disable CORS (default: true)
CORS_ENABLED=true

# Allowed origins (comma-separated, use * for all)
# For production, specify exact origins
CORS_ALLOWED_ORIGINS=*

# Allowed HTTP methods (comma-separated)
CORS_ALLOWED_METHODS=GET,POST,PUT,DELETE,OPTIONS

# Allowed headers (comma-separated)
CORS_ALLOWED_HEADERS=Content-Type,Authorization,X-User-ID

# Allow credentials (cookies, authorization headers)
CORS_ALLOW_CREDENTIALS=true

# =============================================================================
# LOGGING CONFIGURATION
# =============================================================================

# Log level: debug, info, warn, error (default: info)
LOG_LEVEL=info

# Log format: json or text (default: text)
LOG_FORMAT=text

# Log output: stdout, stderr, or file path (default: stdout)
LOG_OUTPUT=stdout

# =============================================================================
# ENVIRONMENT-SPECIFIC EXAMPLES
# =============================================================================

# Development
# -----------
# PORT=9206
# DB_TYPE=sqlite
# DB_PATH=./athena.db
# LOG_LEVEL=debug
# LOG_FORMAT=text
# CORS_ENABLED=true
# CORS_ALLOWED_ORIGINS=http://localhost:*,http://127.0.0.1:*

# Production
# ----------
# PORT=8080
# DB_TYPE=sqlite
# DB_PATH=/data/athena.db
# JWT_SECRET=<strong-random-secret>
# LOG_LEVEL=info
# LOG_FORMAT=json
# LOG_OUTPUT=/var/log/athena/app.log
# CORS_ENABLED=true
# CORS_ALLOWED_ORIGINS=https://athena.example.com
# CORS_ALLOW_CREDENTIALS=true
